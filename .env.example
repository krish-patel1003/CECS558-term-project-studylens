# StudyLens configuration. Copy to .env (which is git-ignored) and adjust.
# No secrets are required: the model runs locally and the default model is public.

# Which extractor turns an image into a graph:
#   qwen        Qwen2.5-VL-3B-Instruct (AI; downloads ~7.5 GB of weights on first use)
#   annotation  NON-AI fallback: returns the ground-truth graph of a bundled sample diagram
EXTRACTOR_BACKEND=annotation

# Hugging Face model id or local path for the qwen backend
QWEN_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
# auto | cuda | mps | cpu
STUDYLENS_DEVICE=auto
# Extraction output limit. Each box costs ~28 tokens, so dense diagrams need >1024.
QWEN_MAX_NEW_TOKENS=3072
# Longest image side (px) passed to the VLM; larger images are downscaled in memory.
# 1024 keeps small labels readable; 448 matches the fine-tuning resolution (used by the evaluation).
QWEN_MAX_IMAGE_SIDE=1024
# LoRA adapter for graph extraction produced by scripts/train_lora.py (leave empty for zero-shot)
QWEN_ADAPTER_PATH=checkpoints/ai2d_lora_r16
# extraction = legacy whole-graph adapter (train_lora.py); dsg = grounding + arrows adapter (train_dsg_lora.py)
ADAPTER_KIND=extraction

# dsg = OCR-anchored Diagram Scene Graph (default; needs the OCR venv); legacy = one-call JSON extraction
EXTRACTION_MODE=dsg
# Python interpreter of the separate PaddleOCR venv used by the E1 baseline (docs/code_guide.md)
OCR_PYTHON=external/venv-ocr/bin/python

# Upload limits
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=40000000

# 1 = show the "ask the VLM directly" comparison button (only with EXTRACTOR_BACKEND=qwen)
ENABLE_DIRECT_VLM=1

# Optional: only needed if you hit Hugging Face rate limits. Put the real value in .env, never here.
# HF_TOKEN=<your-hugging-face-token>
